{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dns_query.v1.json",
  "title": "DNS_QUERY",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.v1.json#/$defs/sensor_fields"
    }
  ],
  "required": [],
  "properties": {
    "process": {
      "$ref": "common.v1.json#/$defs/process"
    },
    "dns": {
      "$ref": "common.v1.json#/$defs/dns"
    },
    "qname": {
      "type": "string",
      "minLength": 1,
      "description": "Top-level query name kept for v1 rules."
    }
  },
  "anyOf": [
    {
      "required": [
        "dns"
      ]
    },
    {
      "required": [
        "qname"
      ]
    }
  ]
}

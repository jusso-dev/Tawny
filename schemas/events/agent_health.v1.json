{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_health.v1.json",
  "title": "AGENT_HEALTH",
  "type": "object",
  "required": [
    "sensor_version",
    "buffer_depth",
    "uptime_seconds"
  ],
  "properties": {
    "sensor_version": {
      "type": "string"
    },
    "buffer_depth": {
      "type": "integer",
      "minimum": 0
    },
    "uptime_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "next_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "boot_id": {
      "type": "string"
    },
    "key_protection": {
      "enum": [
        "keychain",
        "dpapi",
        "tpm",
        "file"
      ]
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "running",
              "degraded",
              "stopped",
              "silent",
              "failed",
              "missing",
              "unknown"
            ]
          },
          "last_event_age_seconds": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "update": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "disabled_no_release_key",
            "idle",
            "checking",
            "downloading",
            "staged",
            "restarting",
            "health_check",
            "committed",
            "rolled_back",
            "refused",
            "failed"
          ]
        },
        "version": {
          "type": "string"
        },
        "ring": {
          "enum": [
            "canary",
            "internal",
            "10",
            "50",
            "100"
          ]
        },
        "bucket": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
